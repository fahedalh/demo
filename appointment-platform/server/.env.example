# --- Core ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/bookly
# Optional: enables distributed booking locks, shared cache. Without it an in-process fallback is used.
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# --- Payments (Stripe takes precedence when set) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Sandbox checkout page for development. Set to false in production.
PAYMENTS_TEST_PROVIDER=true

# --- Messaging (each channel is skipped and logged when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bookly <no-reply@bookly.local>"
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Uploads ---
CLOUDINARY_URL=

# --- AI (optional; heuristic provider is used when unset) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

JOBS_ENABLED=true
LOG_LEVEL=info
