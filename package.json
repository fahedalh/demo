{
  "name": "masar-ride-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Masar \u2014 a full ride-hailing platform: passenger, driver and admin apps on one Node.js/Express + Socket.IO + PostgreSQL backend",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @masar/api dev",
    "dev:passenger": "pnpm --filter @masar/passenger-web dev",
    "dev:driver": "pnpm --filter @masar/driver-web dev",
    "dev:admin": "pnpm --filter @masar/admin-dashboard dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @masar/shared test && pnpm --filter @masar/api test",
    "test:e2e": "node scripts/e2e-flow.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "simulate:drivers": "pnpm --filter @masar/api simulate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.20.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
