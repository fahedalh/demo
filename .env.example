# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Comma-separated origins allowed by CORS / Socket.IO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
PUBLIC_API_URL=http://localhost:4000

# ─── Database & cache ───────────────────────────────────
DATABASE_URL=postgresql://masar:masar@localhost:5432/masar?schema=public
REDIS_URL=redis://localhost:6379
# Set to "true" when running several API instances behind a load balancer
SOCKET_REDIS_ADAPTER=false

# ─── Auth (generate with: openssl rand -hex 48) ─────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ─── Maps ───────────────────────────────────────────────
# local   : offline routing + curated Dubai places (default, no keys, deterministic)
# osm     : Photon geocoding + OSRM routing (public servers, falls back to local)
# mapbox  : Mapbox Geocoding + Directions (needs MAPBOX_TOKEN)
# google  : Google Places + Directions (needs GOOGLE_MAPS_API_KEY)
GEO_PROVIDER=local
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=
# Demo/testing only: accept rides at any location, priced like the nearest service area.
SERVICE_ANYWHERE=false

# ─── Payments ───────────────────────────────────────────
# sandbox : built-in simulated card processor (default; no money moves)
# stripe  : Stripe test/live mode (needs both keys below)
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secret used to sign sandbox webhooks (so the webhook code path is exercised locally)
SANDBOX_WEBHOOK_SECRET=change-me-sandbox-webhook-secret

# ─── OTP / messaging ────────────────────────────────────
# console : codes are logged by the API (development). twilio/smtp adapters plug in here.
OTP_DELIVERY=console

# ─── Storage ────────────────────────────────────────────
# Private directory for driver documents (never served statically)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8

# ─── Frontends (Vite, exposed to the browser — never put secrets here) ──
VITE_API_URL=
VITE_MAP_TILE_URL=
VITE_DEFAULT_CENTER=25.2048,55.2708
