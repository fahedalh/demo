    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
